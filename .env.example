# Copy this file to .env and fill it in. Never share or commit .env.

# ---- Sign-in ----
# A long random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Where the site runs. Links in emails point here. Local: http://localhost:5173. Live: your Netlify address.
CLIENT_ORIGIN=http://localhost:5173

# ---- The owner's login, created on first start (12+ character password). Delete ADMIN_PASSWORD afterwards. ----
ADMIN_EMAILS=you@yourdomain.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=
# Who is told about every new signup
NOTIFY_EMAIL=you@yourdomain.com

# ---- Email ----
# console: print emails (and their links) in the terminal, send nothing. Or: altermail, resend, sendgrid, brevo, postmark
EMAIL_PROVIDER=console
EMAIL_API_KEY=
# The address must be on a domain you have verified with your email service
MAIL_FROM="AbiSentry Gossip <alerts@yourdomain.com>"

# ---- Database ----
# Leave both empty locally and data is kept in a file (data/store.json). Fill both in to use Convex.
CONVEX_URL=
# A long random value. The SAME value must be set in Convex: npx convex env set STORE_SECRET <value>
STORE_SECRET=

# ---- Only on Netlify (set in the site's environment variables, not here) ----
# NODE_ENV=production
# ALERT_EMAILS=background
# INTERNAL_SECRET=<another long random value>
